            "text": {
              "extractions": [
                {
                  "source_id": "Product Brief: Advanced Analytics Dashboard",
                  "source_type": "Product Brief",
                  "stated_requirements": [
                    "Dashboard should display 5 core metrics: revenue, active users, churn rate, NPS score, and support ticket volume",
                    "Users should be able to filter by date range (last 7 days, 30 days, 90 days, custom)",
                    "Data should refresh every 15 minutes (not real-time, to manage cost)",
                    "Must support role-based access: executives see all data, team leads see their team only",
                    "Export to PDF for monthly board reports"
                  ],
                  "ambiguous_items": [
                    "Should we support custom dashboard layouts or ship a fixed layout first?",
                    "Do we need alerting (e.g., notify when churn exceeds 5%)?",
                    "What is the acceptable page load time?"
                  ],
                  "missing_info": [
                    "What metrics should be included in the alerting system?",
                    "What specific user roles will be defined for role-based access?"
                  ],
                  "constraints": [
                    "Must integrate with our existing PostgreSQL data warehouse",
                    "Cannot use any third-party analytics tools (licensing cost concern)",
                    "Must be accessible on mobile (responsive design)",
                    "Target launch: Q3 2026"
                  ],
                  "stakeholders": [
                    "Priya Sharma, Product Manager",
                    "Business analysts",
                    "Team leads",
                    "Executives"
                  ],
                  "deadlines": [
                    "Target launch: Q3 2026"
                  ],
                  "contradictions_flagged": [],
                  "extraction_notes": "The brief outlines clear requirements and constraints for the analytics dashboard, with some open questions that need to be addressed."
